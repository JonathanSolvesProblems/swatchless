# YouCam API (Perfect Corp). Server-side only. https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
# Claude, which drives the consult through the YouCam MCP server. An Anthropic API key created for this app, never one inherited from the shell.
SWATCHLESS_ANTHROPIC_API_KEY=
# Live consults spend on two paid APIs: set both on any public deployment.
CONSULT_ACCESS_CODE=
NEXT_PUBLIC_CONSULT_CODE_REQUIRED=1
CONSULT_DAILY_LIMIT=15
# Where consult records are written (customer photo, renders, agent log).
CONSULT_DIR=.consults
